{
  "Routes": [
    //Catalog Mikroservisi – okuma: ziyaretçi token'ı (CatalogReadPermission) da yeterli
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7070
        }
      ],
      "UpstreamPathTemplate": "/services/catalog/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "CatalogReadPermission", "CatalogFullPermission" ]
      }
    },
    //Catalog Mikroservisi – yazma: yalnızca giriş yapmış kullanıcı token'ı (CatalogFullPermission)
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7070
        }
      ],
      "UpstreamPathTemplate": "/services/catalog/{everything}",
      "UpstreamHttpMethod": [ "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "CatalogFullPermission" ]
      }
    },
    //Ürün görselleri – Catalog'un yerel depolaması (FileStorage:Provider=Local). Token yok:
    //tarayıcı <img> isteğine token ekleyemez. Yalnızca GET; yükleme /services/catalog üzerinden (Admin).
    {
      "DownstreamPathTemplate": "/uploads/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7070
        }
      ],
      "UpstreamPathTemplate": "/uploads/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamScheme": "http"
    },
    //Discount Mikroservisi
    {
      //Downstream tarafı ise bu gelen isteği ocelet tarafında nasıl karşılıcaz ve geri göndericez.
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7071
        }
      ],
      //Upstream tarafı client tarafından bize gelen istek tarafı.
      "UpstreamPathTemplate": "/services/discount/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "DiscountFullPermission" ]
      }
    },
    //Order Mikroservisi
    {
      //Downstream tarafı ise bu gelen isteği ocelet tarafında nasıl karşılıcaz ve geri göndericez.
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7072
        }
      ],
      //Upstream tarafı client tarafından bize gelen istek tarafı.
      "UpstreamPathTemplate": "/services/order/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "OrderFullPermission" ]
      }
    },
    //Cargo Mikroservisi
    {
      //Downstream tarafı ise bu gelen isteği ocelet tarafında nasıl karşılıcaz ve geri göndericez.
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7073
        }
      ],
      //Upstream tarafı client tarafından bize gelen istek tarafı.
      "UpstreamPathTemplate": "/services/cargo/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "CargoFullPermission" ]
      }
    },
    //Basket Mikroservisi
    {
      //Downstream tarafı ise bu gelen isteği ocelet tarafında nasıl karşılıcaz ve geri göndericez.
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7074
        }
      ],
      //Upstream tarafı client tarafından bize gelen istek tarafı.
      "UpstreamPathTemplate": "/services/basket/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "BasketFullPermission" ]
      }
    },
    //Comment Mikroservisi – okuma: ziyaretçi token'ı (CommentReadPermission) da yeterli
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7075
        }
      ],
      "UpstreamPathTemplate": "/services/comment/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "CommentReadPermission", "CommentFullPermission" ]
      }
    },
    //Comment Mikroservisi – yazma: yorum yapmak için giriş gerekir (CommentFullPermission)
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7075
        }
      ],
      "UpstreamPathTemplate": "/services/comment/{everything}",
      "UpstreamHttpMethod": [ "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "CommentFullPermission" ]
      }
    },
    //Payment Mikroservisi
    {
      //Downstream tarafı ise bu gelen isteği ocelet tarafında nasıl karşılıcaz ve geri göndericez.
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7076
        }
      ],
      //Upstream tarafı client tarafından bize gelen istek tarafı.
      "UpstreamPathTemplate": "/services/payment/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "PaymentFullPermission" ]
      }
    },
    //Message Mikroservisi – iletişim formu: ziyaretçi giriş yapmadan mesaj gönderebilir
    {
      "DownstreamPathTemplate": "/api/contacts",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7078
        }
      ],
      "UpstreamPathTemplate": "/services/message/contacts",
      "UpstreamHttpMethod": [ "Post" ],
      "UpstreamScheme": "http",
      "Priority": 2,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "ContactWritePermission", "MessageFullPermission" ]
      }
    },
    //Message Mikroservisi
    {
      //Downstream tarafı ise bu gelen isteği ocelet tarafında nasıl karşılıcaz ve geri göndericez.
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7078
        }
      ],
      //Upstream tarafı client tarafından bize gelen istek tarafı.
      "UpstreamPathTemplate": "/services/message/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "MessageFullPermission" ]
      }
    },
    //Notification – admin paneli REST API'si (bildirim kutusu, ayarlar, test). Servis ayrıca Admin rolü ister.
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7079
        }
      ],
      "UpstreamPathTemplate": "/services/notification/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "UpstreamScheme": "http",
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "NotificationFullPermission" ]
      }
    },
    //Notification – admin paneli SignalR hub'ı (WebSocket). Ocelot WebSocket rotalarında kimlik doğrulama yapamaz;
    //token (?access_token=) hub'da doğrulanır (Admin rolü + NotificationFullPermission). İstemci negotiate'i atlar (skipNegotiation).
    {
      "DownstreamPathTemplate": "/hubs/notification",
      "DownstreamScheme": "ws",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7079
        }
      ],
      "UpstreamPathTemplate": "/hubs/notification",
      "UpstreamHttpMethod": [ "Get" ]
    },
    //Admin dashboard – Catalog istatistikleri (aggregate: /services/admin/dashboard). Servis ayrıca Admin rolü ister.
    {
      "Key": "catalog",
      "DownstreamPathTemplate": "/api/statistics",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7070
        }
      ],
      "UpstreamPathTemplate": "/services/catalog/statistics",
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamScheme": "http",
      "Priority": 2,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "CatalogFullPermission" ]
      }
    },
    //Admin dashboard – Comment istatistikleri
    {
      "Key": "comment",
      "DownstreamPathTemplate": "/api/statistics",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7075
        }
      ],
      "UpstreamPathTemplate": "/services/comment/statistics",
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamScheme": "http",
      "Priority": 2,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "CommentFullPermission" ]
      }
    },
    //Admin dashboard – Discount istatistikleri
    {
      "Key": "discount",
      "DownstreamPathTemplate": "/api/statistics",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7071
        }
      ],
      "UpstreamPathTemplate": "/services/discount/statistics",
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamScheme": "http",
      "Priority": 2,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "DiscountFullPermission" ]
      }
    },
    //Admin dashboard – Message istatistikleri (üst menüdeki zarf da kullanır)
    {
      "Key": "message",
      "DownstreamPathTemplate": "/api/statistics",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7078
        }
      ],
      "UpstreamPathTemplate": "/services/message/statistics",
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamScheme": "http",
      "Priority": 2,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "MessageFullPermission" ]
      }
    },
    //Admin dashboard – Identity istatistikleri (kullanıcı sayısı). WebUI önceden IdentityServer'ı gateway'siz çağırıyordu
    {
      "Key": "identity",
      "DownstreamPathTemplate": "/api/statistics",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5010
        }
      ],
      "UpstreamPathTemplate": "/services/identity/statistics",
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamScheme": "http",
      "Priority": 2,
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "OcelotAuthenticationSheme",
        "AllowedScopes": [ "IdentityServerApi" ]
      }
    }
  ],
  // Admin dashboard: beş servisin istatistik ucu paralel çağrılır, DashboardAggregator tek JSON'da birleştirir.
  // Her alt route kendi AuthenticationOptions'ıyla ayrıca doğrulanır (Ocelot'ta multiplexing, kimlik doğrulamadan önce çalışır).
  "Aggregates": [
    {
      "RouteKeys": [ "catalog", "comment", "discount", "message", "identity" ],
      "UpstreamPathTemplate": "/services/admin/dashboard",
      "Aggregator": "DashboardAggregator"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5020"
  }
}