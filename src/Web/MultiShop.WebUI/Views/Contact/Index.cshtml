@model CreateContactMessageDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="#">Ana Sayfa</a>
                <span class="breadcrumb-item active">İletişim</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4"><span class="bg-secondary pr-3">Bize Yazın</span></h2>
    <div class="row px-xl-5">
        <div class="col-lg-7 mb-5">
            <div class="contact-form bg-light p-30">
                <div id="success">
                    @if (TempData["ContactSent"] is true)
                    {
                        <div class="alert alert-success">Mesajınız alındı. En kısa sürede size dönüş yapacağız.</div>
                    }
                </div>
                <form method="post">
                    @if (ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    }
                    <div class="control-group">
                        <input type="text" class="form-control" id="name" placeholder="Adınız Soyadınız"
                               required="required" data-validation-required-message="Lütfen boş geçmeyin" asp-for="NameSurname" />
                        <span class="help-block text-danger" asp-validation-for="NameSurname"></span>
                    </div>
                    <div class="control-group">
                        <input type="email" class="form-control" id="email" placeholder="Email Adresiniz"
                               required="required" data-validation-required-message="Lütfen boş geçmeyin" asp-for="Email" />
                        <span class="help-block text-danger" asp-validation-for="Email"></span>
                    </div>
                    <div class="control-group">
                        <input type="text" class="form-control" id="subject" placeholder="Konu"
                               required="required" data-validation-required-message="Lütfen boş geçmeyin" asp-for="Subject" />
                        <span class="help-block text-danger" asp-validation-for="Subject"></span>
                    </div>
                    <div class="control-group">
                        <textarea class="form-control" rows="8" id="message" placeholder="Mesajınız"
                                  required="required"
                                  data-validation-required-message="Lütfen boş geçmeyin" asp-for="Message"></textarea>
                        <span class="help-block text-danger" asp-validation-for="Message"></span>
                    </div>
                    <div>
                        <button class="btn btn-primary py-2 px-4" type="submit" id="sendMessageButton">
                            Mesajı
                            Gönder
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @await Component.InvokeAsync("_ContactDetailComponentPartial")
        
    </div>
</div>