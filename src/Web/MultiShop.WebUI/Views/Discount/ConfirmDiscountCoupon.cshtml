@model BasketDto
<div class="col-lg-4">
    @if (Model.CouponCode is null)
    {
        <form class="mb-30" asp-controller="Discount" asp-action="ConfirmDiscountCoupon" method="post">
            <div class="input-group">
                <input type="text" name="code" class="form-control border-0 p-4" required maxlength="50" placeholder="Kupon Kodunuz">
                <div class="input-group-append">
                    <button class="btn btn-primary">Kuponu Uygula</button>
                </div>
            </div>
        </form>
    }
    else
    {
        <form class="mb-30" asp-controller="Discount" asp-action="RemoveDiscountCoupon" method="post">
            <div class="input-group">
                <input type="text" class="form-control border-0 p-4" value="@Model.CouponCode (%@Model.DiscountRate)" readonly>
                <div class="input-group-append">
                    <button class="btn btn-secondary">Kuponu Kaldır</button>
                </div>
            </div>
        </form>
    }
    <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Sipariş Özeti</span></h5>
    <form class="mb-30" asp-controller="Discount" asp-action="ConfirmOder" method="post">
        <div class="bg-light p-30 mb-5">
            <partial name="~/Views/Shared/_BasketTotals.cshtml" model="Model" />
            @if (Model.Items.Count > 0)
            {
                <button class="btn btn-block btn-primary font-weight-bold my-3 py-3">Ödeme Adımına Geç</button>
            }
        </div>
    </form>
</div>
