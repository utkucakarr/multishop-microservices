@model List<GetByIdProductImageDto>
@{
    // Ana görsel önce, sonra görüntüleme sırasına göre.
    var images = Model.OrderByDescending(x => x.IsMain).ThenBy(x => x.DisplayOrder).ToList();
}

<div class="col-lg-5 mb-30">
    <div id="product-carousel" class="carousel slide" data-ride="carousel">
        <div class="carousel-inner bg-light">
            @if (images.Count == 0)
            {
                <div class="carousel-item active">
                    <div class="w-100 d-flex align-items-center justify-content-center text-muted" style="min-height: 300px;">Bu ürün için görsel yok</div>
                </div>
            }
            @for (var i = 0; i < images.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img class="w-100 h-100" src="@images[i].ImageUrl" alt="Image">
                </div>
            }
        </div>
        @if (images.Count > 1)
        {
            <a class="carousel-control-prev" href="#product-carousel" data-slide="prev">
                <i class="fa fa-2x fa-angle-left text-dark"></i>
            </a>
            <a class="carousel-control-next" href="#product-carousel" data-slide="next">
                <i class="fa fa-2x fa-angle-right text-dark"></i>
            </a>
        }
    </div>
</div>
