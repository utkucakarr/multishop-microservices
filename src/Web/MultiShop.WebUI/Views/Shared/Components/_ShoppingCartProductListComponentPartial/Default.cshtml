@model BasketDto
<div class="col-lg-8 table-responsive mb-5">
    <table class="table table-light table-borderless table-hover text-center mb-0">
        <thead class="thead-dark">
            <tr>
                <th>Ürün</th>
                <th>Fiyat</th>
                <th>Miktar</th>
                <th>Toplam</th>
                <th>Kaldır</th>
            </tr>
        </thead>
        <tbody class="align-middle">
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="align-middle">Sepetiniz boş.</td>
                </tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="align-middle"><img src="@item.ProductImageUrl" alt="" style="width: 50px; height:60px"> @item.ProductName</td>
                    <td class="align-middle">@item.UnitPrice.ToString("N2") ₺</td>
                    <td class="align-middle">
                        @* "quantity" sınıfı yok: temanın main.js'i ".quantity button" tıklamasında yakındaki input'u (formdaki antiforgery token'ını) değiştirir. *@
                        <div class="input-group mx-auto" style="width: 100px;">
                            <div class="input-group-btn">
                                <form method="post" asp-area="" asp-controller="ShoppingCard" asp-action="RemoveBasketItem" asp-route-productId="@item.ProductId" asp-route-quantity="@item.Quantity" class="inline-form">
                                    <button type="submit" class="btn btn-sm btn-primary btn-minus" title="Azalt"><i class="fa fa-minus"></i></button>
                                </form>
                            </div>
                            <input type="text" class="form-control form-control-sm bg-secondary border-0 text-center" value="@item.Quantity" readonly>
                            <div class="input-group-btn">
                                <form method="post" asp-area="" asp-controller="ShoppingCard" asp-action="AddBasketBtnItem" asp-route-productId="@item.ProductId" class="inline-form">
                                    <button type="submit" class="btn btn-sm btn-primary btn-plus" title="Arttır"><i class="fa fa-plus"></i></button>
                                </form>
                            </div>
                        </div>
                    </td>
                    <td class="align-middle">@item.LineTotal.ToString("N2") ₺</td>
                    <td class="align-middle">
                        <form method="post" asp-area="" asp-controller="ShoppingCard" asp-action="RemoveAllBasketItem" asp-route-productId="@item.ProductId" class="inline-form">
                            <button type="submit" class="btn btn-sm btn-danger" title="Sepetten çıkar"><i class="fa fa-times"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
