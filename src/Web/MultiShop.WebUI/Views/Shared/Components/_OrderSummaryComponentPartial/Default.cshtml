@model BasketDto

<div class="bg-light p-30 mb-5">
    <div class="border-bottom">
        <h6 class="mb-3">Sipariş Ürün Listesi</h6>
        @foreach (var item in Model.Items)
        {
            <div class="d-flex justify-content-between">
                <p>@item.ProductName (@item.Quantity)</p>
                <h6>@item.LineTotal.ToString("N2") ₺</h6>
            </div>
        }
    </div>
    <div class="pt-3">
        <partial name="~/Views/Shared/_BasketTotals.cshtml" model="Model" />
    </div>
</div>
