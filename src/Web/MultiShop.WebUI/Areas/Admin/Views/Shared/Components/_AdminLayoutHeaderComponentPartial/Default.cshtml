<header class="main-header dark-bg">

    <a href="../index.html" class="logo dark-bg">
        <span class="logo-mini"><img src="~/online-shop-website-template/images/logos/mulhtishop1.jpg" style="width:50px; height:50px; important!" alt="Ovio"></span>
        <span class="logo-lg"><img src="~/online-shop-website-template/images/logos/mulhtishop1.jpg" style="width:200px; height:50px; important!" alt="Ovio"></span>
    </a>

    <nav class="navbar navbar-static-top" role="navigation">
        <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button"> <span class="sr-only">Toggle navigation</span> </a>
        <div class="pull-left search-box">
            <form action="#" method="get" class="search-form">
                <div class="input-group">
                    <input type="text" name="search" class="form-control" placeholder="Aranacak kelimeyi giriniz">
                    <span class="input-group-btn">
                        <button type="submit" name="search" id="search-btn" class="btn btn-flat"><i class="fa fa-search"></i> </button>
                    </span>
                </div>
            </form>
        </div>
        <div class="navbar-custom-menu">
            <ul class="nav navbar-nav">
                @* Mesajlar: iletişim formundan gelenler *@
                <li class="dropdown messages-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <i class="icon-envelope"><span class="badge" style="position:relative;top:-10px"><strong>@ViewBag.messageCount</strong></span></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="header">@(ViewBag.messageCount ?? "—") okunmamış mesaj</li>
                        <li>
                            <ul class="menu">
                                @foreach (var item in (List<ResultContactMessageDto>)ViewBag.latestContactMessages)
                                {
                                    <li>
                                        <a href="/Admin/ContactMessage/Detail/@item.ContactMessageId">
                                            <h4 style="@(item.IsRead ? "" : "font-weight:bold")">@item.NameSurname</h4>
                                            <p>@item.Subject</p>
                                            <p><small><i class="fa fa-clock-o"></i> @item.SendDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></p>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                        <li class="footer"><a href="/Admin/ContactMessage/Index">Tüm mesajlar</a></li>
                    </ul>
                </li>
                @* Bildirimler (Notification servisi): sayı ve liste admin-notifications.js ile canlı güncellenir *@
                @{
                    int? notificationCount = ViewBag.notificationCount;
                    var latestNotifications = (List<NotificationListItemDto>)ViewBag.latestNotifications;
                }
                <li class="dropdown notifications-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" title="Bildirimler">
                        <i class="fa fa-bell"><span class="badge" id="notification-badge" style="position:relative;top:-10px;@(notificationCount > 0 ? "" : "display:none")">@notificationCount</span></i>
                    </a>
                    <ul class="dropdown-menu">
                        <li class="header"><span id="notification-count-text">@(notificationCount?.ToString() ?? "—")</span> okunmamış bildirim</li>
                        <li>
                            <ul class="menu" id="notification-list">
                                @foreach (var item in latestNotifications)
                                {
                                    <li>
                                        <a href="/Admin/Notification/Detail/@item.Id">
                                            <h4 style="@(item.ReadAt is null ? "font-weight:bold" : "")">@item.Title</h4>
                                            <p>@item.Message</p>
                                            <p><small><i class="fa fa-clock-o"></i> @item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></p>
                                        </a>
                                    </li>
                                }
                                @if (latestNotifications.Count == 0)
                                {
                                    <li id="notification-empty" style="padding:10px" class="text-muted">Bildirim yok</li>
                                }
                            </ul>
                        </li>
                        <li class="footer"><a href="/Admin/Notification/Index">Tüm bildirimler</a></li>
                    </ul>
                </li>
                <li class="dropdown user user-menu">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown"> <img src="~/online-shop-website-template/images/logos/manlogo.jpg" class="user-image" alt="User Image"> <span class="hidden-xs">@ViewBag.userName</span> </a>
                    <ul class="dropdown-menu">
                        <li class="user-header">
                            <div class="pull-left user-img"><img src="~/online-shop-website-template/images/logos/manlogo.jpg" class="img-responsive" alt="User"></div>
                            <p class="text-left">@ViewBag.userName <small>@ViewBag.userMail</small> </p>
                            <div class="view-link text-left"><a href="#">Profili İncele</a> </div>
                        </li>
                        <li><a href="#"><i class="icon-profile-male"></i> Profilim</a></li>
                        <li><a href="#"><i class="icon-wallet"></i> Bakiyem</a></li>
                        <li><a href="/Admin/ContactMessage/Index"><i class="icon-envelope"></i> Mesajlar</a></li>
                        <li role="separator" class="divider"></li>
                        <li><a href="#"><i class="icon-gears"></i> Hesap Ayarları</a></li>
                        <li role="separator" class="divider"></li>
                        <li><form method="post" asp-area="" asp-controller="Login" asp-action="Logout" style="display:none"></form><a onclick="this.previousElementSibling.submit(); return false;" href="#"><i class="fa fa-power-off"></i> Çıkış Yap</a></li>
                    </ul>
                </li>
            </ul>
        </div>
    </nav>
</header>