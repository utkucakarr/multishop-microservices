@model List<ResultCargoCompanyDto>

@{
    ViewData["Title"] = "CargoCompanyList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                }
                <p>Yeni gönderiler <strong>varsayılan</strong> firmaya atanır (işaretli firma yoksa ilk eklenen firmaya). Hiç firma yoksa gönderi kargoya verilemez.</p>
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Kargo Adı</th>
                                <th>Varsayılan</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.CargoCompanyName</td>
                                    <td>
                                        @if (item.IsDefault)
                                        {
                                            <span class="label label-success">Varsayılan</span>
                                        }
                                        else
                                        {
                                            <form method="post" action="/Admin/Cargo/SetDefaultCargoCompany" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.CargoCompanyId" />
                                                <button type="submit" class="btn btn-default btn-sm">Varsayılan yap</button>
                                            </form>
                                        }
                                    </td>
                                    <td><a href="/Admin/Cargo/DeleteCargoCompany/@item.CargoCompanyId" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Admin/Cargo/UpdateCargoCompany/@item.CargoCompanyId" class="btn btn-success">Güncelle</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <br />
                    <a href="/Admin/Cargo/CreateCargoCompany/" class="btn btn-primary">Yeni Cargo Firma Girişi</a>
                </div>
            </div>
        </div>
    </div>
</section>