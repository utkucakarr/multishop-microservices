@model List<ResultOrderingByUserIdDto>

@{
    ViewData["Title"] = "Siparişler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    string? selectedStatus = ViewBag.status;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Siparişler <small>(@Model.Count kayıt)</small></h4>

                <form method="get" action="/Admin/Order/Index" class="form-inline" style="margin-bottom:15px">
                    <label for="status">Durum:&nbsp;</label>
                    <select name="status" id="status" class="form-control" onchange="this.form.submit()">
                        <option value="">Tümü</option>
                        @foreach (var status in OrderStatusDisplay.All)
                        {
                            <option value="@status" selected="@(status == selectedStatus)">@OrderStatusDisplay.Text(status)</option>
                        }
                    </select>
                </form>

                @if (Model.Count == 0)
                {
                    <p>Bu durumda sipariş yok.</p>
                }
                else
                {
                    <div class="bs-example" data-example-id="bordered-table">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Sipariş No</th>
                                    <th>Kullanıcı</th>
                                    <th>Tarih</th>
                                    <th>Tutar</th>
                                    <th>Durum</th>
                                    <th>Açıklama</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td title="@item.OrderNumber">@item.OrderNumber.ToString()[..8].ToUpperInvariant()</td>
                                        <td title="@item.UserId">@item.UserId[..Math.Min(8, item.UserId.Length)]…</td>
                                        <td>@item.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                        <td>@item.TotalPrice.ToString("N2") ₺</td>
                                        <td><span class="label @OrderStatusDisplay.LabelClass(item.Status)">@OrderStatusDisplay.Text(item.Status)</span></td>
                                        <td>@item.FailMessage</td>
                                        <td>
                                            <a href="/Admin/Order/Detail/@item.OrderingId" class="btn btn-primary btn-sm">Satırlar</a>
                                            @if (OrderStatusDisplay.IsOpen(item.Status))
                                            {
                                                <form method="post" action="/Admin/Order/Cancel" style="display:inline"
                                                      onsubmit="return confirm('Sipariş iptal edilsin mi? Ayrılan stok bırakılır.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="orderNumber" value="@item.OrderNumber" />
                                                    <input type="hidden" name="status" value="@selectedStatus" />
                                                    <button type="submit" class="btn btn-danger btn-sm">İptal et</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
