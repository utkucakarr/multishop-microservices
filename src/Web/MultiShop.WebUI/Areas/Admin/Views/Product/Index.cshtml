@model List<ResultProductDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int count = 0;
    var brandNames = (Dictionary<string, string>)ViewBag.BrandNames;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <div class="bs-example" data-example-id="bordered-table">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün Adı</th>
                                <th>Ürün Fiyatı</th>
                                <th>Marka</th>
                                <th title="Eldeki stok; kaydetmek için Enter">Stok</th>
                                <th title="Ödemesi beklenen siparişlere ayrılmış">Ayrılmış</th>
                                <th title="Stok − Ayrılmış">Satılabilir</th>
                                <th>Sil</th>
                                <th>Güncelle</th>
                                <th>Görseller</th>
                                <th>Açıklama ve Bilgi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                count++;
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.ProductName</td>
                                    <td>@item.ProductPrice</td>
                                    <td>@(item.BrandId != null && brandNames.TryGetValue(item.BrandId, out var brandName) ? brandName : "Markasız")</td>
                                    <td>
                                        <form asp-action="UpdateStock" asp-route-id="@item.ProductId" method="post" style="display:flex; gap:4px;">
                                            <input type="number" name="availableStock" value="@item.AvailableStock" min="@item.ReservedStock" max="1000000" class="form-control input-sm" style="width:90px;" required />
                                            <button type="submit" class="btn btn-default btn-sm">Kaydet</button>
                                        </form>
                                    </td>
                                    <td>@item.ReservedStock</td>
                                    <td>@(item.AvailableStock - item.ReservedStock)</td>
                                    <td><a href="/Admin/Product/DeleteProduct/@item.ProductId" class="btn btn-danger">Sil</a></td>
                                    <td><a href="/Admin/Product/UpdateProduct/@item.ProductId" class="btn btn-success">Güncelle</a></td>
                                    <td><a href="/Admin/ProductImage/ProductImageDetail/@item.ProductId" class="btn btn-warning">Görseller</a></td>
                                    <td><a href="/Admin/ProductDetail/UpdateProductDetail/@item.ProductId" class="btn btn-info">Açıklama</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <br />
                    <a href="/Admin/Product/CreateProduct/" class="btn btn-primary">Yeni Ürün Girişi</a>
                </div>
            </div>
        </div>
    </div>
</section>