@model List<ResultOrderAddressDto>
@{
    ViewData["Title"] = "Kullanıcı Adresleri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Kullanıcının Adresleri <small>(@Model.Count kayıt)</small></h4>
                @if (Model.Count == 0)
                {
                    <p>Kullanıcının kayıtlı adresi yok (sipariş verirken eklenir).</p>
                }
                else
                {
                    <div class="bs-example" data-example-id="bordered-table">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Ad Soyad</th>
                                    <th>E-posta</th>
                                    <th>Telefon</th>
                                    <th>Adres</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Name @item.SurName</td>
                                        <td>@item.Email</td>
                                        <td>@item.Phone</td>
                                        <td>
                                            @item.Detail1 @item.Detail2<br />
                                            @item.District / @item.City @item.ZipCode, @item.Country
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <a href="/Admin/User/UserList" class="btn btn-default">Kullanıcı listesine dön</a>
            </div>
        </div>
    </div>
</section>
