@model UpdateProductDetailDto

@{
    ViewData["Title"] = "UpdateProductDetail";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Ürün Açıklama ve Bilgi Güncelleme Sayfası</h4>
                @if (ViewBag.ProductName is string productName)
                {
                    <p class="text-muted">Ürün: <strong>@productName</strong></p>
                }
                <br />
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="ProductDetailId" />
                        <input type="hidden" asp-for="ProductId" />
                        <label>Kısa Açıklama</label>
                        <textarea rows="3" class="form-control" asp-for="ShortDescription"></textarea>
                        <span asp-validation-for="ShortDescription" class="text-danger"></span>
                        <br />
                        <label>Uzun Açıklama</label>
                        <textarea rows="6" class="form-control" asp-for="LongDescription"></textarea>
                        <br />
                        <label>Ürün Bilgisi</label>
                        <textarea rows="5" class="form-control" asp-for="ProductInfo"></textarea>
                        <br />
                        <button class="btn btn-success">Ürün Bilgisi Kaydet</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
